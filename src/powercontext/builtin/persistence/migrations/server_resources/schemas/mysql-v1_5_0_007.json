      "statements": [
        "CREATE TABLE `pc_scope_deletions` (`operation_id` varchar(64) CHARACTER SET utf8mb4 COLLATE utf8mb4_bin NOT NULL, `root_scope_id` varchar(256) CHARACTER SET utf8mb4 COLLATE utf8mb4_bin NOT NULL, `membership_digest` varchar(64) CHARACTER SET utf8mb4 COLLATE utf8mb4_bin NOT NULL, `confirmed_scopes` mediumblob NOT NULL, `state` varchar(16) CHARACTER SET utf8mb4 COLLATE utf8mb4_bin NOT NULL, `requested_at` datetime NOT NULL, PRIMARY KEY (`operation_id`), CONSTRAINT `ck_pc_scope_deletions_state` CHECK (`state` in ('cleanup_pending','complete')))",
        "CREATE TABLE `pc_scope_deletion_progress` (`operation_id` varchar(64) CHARACTER SET utf8mb4 COLLATE utf8mb4_bin NOT NULL, `scope_id` varchar(256) CHARACTER SET utf8mb4 COLLATE utf8mb4_bin NOT NULL, `handler` varchar(64) CHARACTER SET utf8mb4 COLLATE utf8mb4_bin NOT NULL, `state` varchar(16) CHARACTER SET utf8mb4 COLLATE utf8mb4_bin NOT NULL, `attempts` int(11) NOT NULL DEFAULT '0', `last_error_code` varchar(64) CHARACTER SET utf8mb4 COLLATE utf8mb4_bin DEFAULT NULL, PRIMARY KEY (`operation_id`, `scope_id`, `handler`), FOREIGN KEY (`operation_id`) REFERENCES `pc_scope_deletions`(`operation_id`) ON UPDATE RESTRICT ON DELETE CASCADE , CONSTRAINT `ck_pc_scope_deletion_progress_state` CHECK (`state` in ('pending','done','failed')), CONSTRAINT `ck_pc_scope_deletion_progress_attempts_nonnegative` CHECK ((`attempts` >= 0)))"
