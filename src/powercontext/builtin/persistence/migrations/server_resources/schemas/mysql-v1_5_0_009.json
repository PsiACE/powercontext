    "v1_5_0_009": {
      "statements": [
        "CREATE TABLE pc_artifact_lineage_origins ( scope_id VARCHAR(256) CHARACTER SET utf8mb4 COLLATE utf8mb4_bin NOT NULL, family VARCHAR(128) CHARACTER SET utf8mb4 COLLATE utf8mb4_bin NOT NULL, artifact_id VARCHAR(128) CHARACTER SET utf8mb4 COLLATE utf8mb4_bin NOT NULL, revision INTEGER NOT NULL, ordinal INTEGER NOT NULL, origin_scope_id VARCHAR(256) CHARACTER SET utf8mb4 COLLATE utf8mb4_bin NOT NULL, origin_kind VARCHAR(16) CHARACTER SET utf8mb4 COLLATE utf8mb4_bin NOT NULL, origin_family VARCHAR(128) CHARACTER SET utf8mb4 COLLATE utf8mb4_bin NOT NULL, origin_id VARCHAR(256) CHARACTER SET utf8mb4 COLLATE utf8mb4_bin NOT NULL, origin_revision INTEGER, locator MEDIUMBLOB, digest VARCHAR(71) CHARACTER SET utf8mb4 COLLATE utf8mb4_bin NOT NULL, PRIMARY KEY (scope_id, family, artifact_id, revision, ordinal), FOREIGN KEY(scope_id, family, artifact_id, revision) REFERENCES pc_artifacts (scope_id, family, artifact_id, revision) ON DELETE CASCADE, CONSTRAINT ck_pc_artifact_lineage_origins_kind CHECK (origin_kind IN ('source', 'artifact')), CONSTRAINT ck_pc_artifact_lineage_origins_revision CHECK ((origin_kind = 'source' AND origin_revision IS NULL) OR (origin_kind = 'artifact' AND origin_revision > 0)) )",
        "CREATE TABLE pc_share_rule_heads ( scope_id VARCHAR(256) CHARACTER SET utf8mb4 COLLATE utf8mb4_bin NOT NULL, rule_id VARCHAR(64) CHARACTER SET utf8mb4 COLLATE utf8mb4_bin NOT NULL, current_version BIGINT NOT NULL, status VARCHAR(16) CHARACTER SET utf8mb4 COLLATE utf8mb4_bin NOT NULL, updated_at BIGINT NOT NULL, PRIMARY KEY (scope_id, rule_id), FOREIGN KEY(scope_id) REFERENCES pc_scopes (scope_id) ON DELETE CASCADE, CONSTRAINT ck_pc_share_rule_heads_version_positive CHECK (current_version > 0), CONSTRAINT ck_pc_share_rule_heads_status CHECK (status IN ('active', 'invalidated')) )",
        "CREATE TABLE pc_share_rule_versions ( scope_id VARCHAR(256) CHARACTER SET utf8mb4 COLLATE utf8mb4_bin NOT NULL, rule_id VARCHAR(64) CHARACTER SET utf8mb4 COLLATE utf8mb4_bin NOT NULL, version BIGINT NOT NULL, payload MEDIUMBLOB NOT NULL, created_at BIGINT NOT NULL, PRIMARY KEY (scope_id, rule_id, version), FOREIGN KEY(scope_id, rule_id) REFERENCES pc_share_rule_heads (scope_id, rule_id) ON DELETE CASCADE, CONSTRAINT ck_pc_share_rule_versions_version_positive CHECK (version > 0) )",
        "CREATE TABLE pc_share_runs ( scope_id VARCHAR(256) CHARACTER SET utf8mb4 COLLATE utf8mb4_bin NOT NULL, run_id VARCHAR(64) CHARACTER SET utf8mb4 COLLATE utf8mb4_bin NOT NULL, rule_id VARCHAR(64) CHARACTER SET utf8mb4 COLLATE utf8mb4_bin NOT NULL, rule_version BIGINT NOT NULL, state VARCHAR(16) CHARACTER SET utf8mb4 COLLATE utf8mb4_bin NOT NULL, outcome VARCHAR(16) CHARACTER SET utf8mb4 COLLATE utf8mb4_bin NOT NULL, notification_key VARCHAR(128) CHARACTER SET utf8mb4 COLLATE utf8mb4_bin, manifest_digest VARCHAR(71) CHARACTER SET utf8mb4 COLLATE utf8mb4_bin NOT NULL, created_at BIGINT NOT NULL, payload MEDIUMBLOB NOT NULL, PRIMARY KEY (scope_id, run_id), FOREIGN KEY(scope_id) REFERENCES pc_scopes (scope_id) ON DELETE CASCADE, CONSTRAINT uq_pc_share_runs_notification UNIQUE (scope_id, rule_id, notification_key), CONSTRAINT ck_pc_share_runs_rule_version_positive CHECK (rule_version > 0), CONSTRAINT ck_pc_share_runs_state CHECK (state IN ('pinned', 'invalidated')), CONSTRAINT ck_pc_share_runs_outcome CHECK (outcome IN ('pending', 'no_change', 'needs_evidence', 'rejected', 'committed')) )",
        "CREATE TABLE pc_share_acceptances ( scope_id VARCHAR(256) CHARACTER SET utf8mb4 COLLATE utf8mb4_bin NOT NULL, rule_id VARCHAR(64) CHARACTER SET utf8mb4 COLLATE utf8mb4_bin NOT NULL, version BIGINT NOT NULL, actor VARCHAR(128) CHARACTER SET utf8mb4 COLLATE utf8mb4_bin NOT NULL, side VARCHAR(16) CHARACTER SET utf8mb4 COLLATE utf8mb4_bin NOT NULL, terms_digest VARCHAR(71) CHARACTER SET utf8mb4 COLLATE utf8mb4_bin NOT NULL, covered_scope_ids MEDIUMBLOB NOT NULL, acceptance_id VARCHAR(64) CHARACTER SET utf8mb4 COLLATE utf8mb4_bin NOT NULL, accepted_at BIGINT NOT NULL, PRIMARY KEY (scope_id, rule_id, version, actor, side), FOREIGN KEY(scope_id, rule_id, version) REFERENCES pc_share_rule_versions (scope_id, rule_id, version) ON DELETE CASCADE, CONSTRAINT uq_pc_share_acceptances_id UNIQUE (acceptance_id), CONSTRAINT ck_pc_share_acceptances_side CHECK (side IN ('origin', 'target')) )",
