export const HOOK_BINDINGS: { event: string; handler: string }[] = {{hooks}}

export function selectHooks<Handlers extends object>(source: string, handlers: Handlers): Partial<Handlers> {
  return Object.fromEntries(HOOK_BINDINGS.filter(binding => binding.handler.startsWith(`${source}:`)).map(binding => {
    const name = binding.handler.slice(source.length + 1) as keyof Handlers
    const handler = handlers[name]
    if (!Object.hasOwn(handlers, name) || handler === undefined) throw new Error(`Missing native hook: ${binding.handler}`)
    return [binding.event, handler]
  })) as Partial<Handlers>
}

export function createHookRegistry<On extends (...args: any[]) => unknown>(source: string, register: On) {
  const handlers: Record<string, any[]> = {}
  return {
    on: ((name: string, ...args: any[]) => { handlers[name] = args }) as On,
    register() {
      const selected = selectHooks(source, handlers)
      for (const [event, args] of Object.entries(selected)) register(event, ...args!)
    },
  }
}
